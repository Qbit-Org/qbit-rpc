{
  "name": "@qbit-oss/rpc",
  "version": "0.0.0",
  "private": true,
  "description": "Node.js JSON-RPC client for qbit Core with capability gating, chain guard, strict result validation and lossless amounts",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib/**/*",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "test": "vitest run --config vitest.config.mts",
    "test:regtest": "vitest run --config test/regtest/vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p test",
    "api:check": "api-extractor run && api-extractor run --config etc/api-extractor.esm.json",
    "api:update": "api-extractor run --local && api-extractor run --config etc/api-extractor.esm.json",
    "clean": "rm -rf lib coverage"
  },
  "keywords": [
    "qbit",
    "json-rpc",
    "qbitd",
    "wallet",
    "qbit-core",
    "rpc-client",
    "psbt",
    "typescript"
  ],
  "author": {
    "name": "Qbit",
    "url": "https://github.com/Qbit-Org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qbit-Org/qbit-rpc.git",
    "directory": "packages/rpc"
  },
  "bugs": {
    "url": "https://github.com/Qbit-Org/qbit-rpc/issues"
  },
  "homepage": "https://github.com/Qbit-Org/qbit-rpc/tree/main/packages/rpc#readme",
  "devDependencies": {
    "@microsoft/api-extractor": "7.60.1",
    "@types/node": "^22.20.5",
    "fast-check": "4.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
