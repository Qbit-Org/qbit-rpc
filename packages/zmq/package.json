{
  "name": "@qbit-oss/zmq",
  "version": "0.0.0",
  "private": true,
  "description": "Node.js ZeroMQ subscriber and strict parser for qbit Core notifications, with sequence-gap events",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib/**/*",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "test": "vitest run --config vitest.config.mts",
    "test:regtest": "vitest run --config test/regtest/vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p test",
    "api:check": "api-extractor run && api-extractor run --config etc/api-extractor.esm.json",
    "api:update": "api-extractor run --local && api-extractor run --config etc/api-extractor.esm.json",
    "clean": "rm -rf lib coverage"
  },
  "keywords": [
    "qbit",
    "zmq",
    "zeromq",
    "qbitd"
  ],
  "author": "Qbit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qbit-Org/qbit-rpc.git",
    "directory": "packages/zmq"
  },
  "bugs": {
    "url": "https://github.com/Qbit-Org/qbit-rpc/issues"
  },
  "homepage": "https://github.com/Qbit-Org/qbit-rpc/tree/main/packages/zmq#readme",
  "peerDependencies": {
    "zeromq": "^6.5.0"
  },
  "peerDependenciesMeta": {
    "zeromq": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.4",
    "@types/node": "^22.20.5",
    "fast-check": "4.10.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "zeromq": "6.5.0"
  }
}
